[user]
  name = truearken
  email = vodelsup@gmail.com
[credential "https://github.com"]
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/usr/bin/gh auth git-credential

[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work

[alias]
    s = status -sb
    pl = pull
    ps = push
    sw = switch
    ada = add -A
    cm = commit
    amend = commit --amend --reuse-message=HEAD
[init]
    defaultBranch = main
[push]
    recurseSubmodules = on-demand
[pull]
    rebase = true
[submodule]
    recurse = true
[core]
	pager = less
[commit]
	gpgsign = true
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[tag]
	gpgSign = true
[gpg]
	format = ssh
